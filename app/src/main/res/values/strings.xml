<resources>
    <string name="app_name">put.io</string>

    <!--
        Inactive account notice, from putio-web AccountStatusNotification and
        packages/translations/src/languages/en.json. Google Play's payments policy
        keeps out web's calls to pay, renew or subscribe and its billing and family
        links (app_expired_account_cta_label, app_expired_account_family_cta_label,
        app_expired_account_family_member_message).
    -->
    <!-- en.json app_expired_account_title, verbatim. -->
    <string name="account_inactive_title">Your account has been deactivated 😢</string>
    <!-- en.json app_passive_account_file_delete_message; web always says "days". -->
    <plurals name="account_inactive_files_deletion">
        <item quantity="one">Your files are still here, but they are scheduled to be deleted in %d day.</item>
        <item quantity="other">Your files are still here, but they are scheduled to be deleted in %d days.</item>
    </plurals>
    <!-- en.json app_expired_account_family_member_title ("Your family plan's owner needs to update
         their payment details to keep your plan active."), without the call to pay. -->
    <string name="account_family_expired_title">Your family plan is no longer active.</string>
</resources>
