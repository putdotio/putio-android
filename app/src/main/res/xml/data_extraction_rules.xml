<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ counterpart of allowBackup="false": the app will hold auth
     tokens, so nothing is cloud-backed-up or device-transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
