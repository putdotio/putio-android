<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Used but not required: keeps the mobile app installable on
         ChromeOS and other pointer-driven devices. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application>
        <activity
            android:name=".auth.MobileOAuthRedirectActivity"
            android:enabled="${putioMobileOAuthCallbackEnabled}"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:path="/callback"
                    android:scheme="putio" />
            </intent-filter>
        </activity>
    </application>
</manifest>
