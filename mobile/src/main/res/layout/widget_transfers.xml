<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen Transfers widget, drawn by the launcher through RemoteViews. Colors are the generated
     design tokens; MobileTransfersWidgetViews sets every text, so a pushed state never keeps another's.
     These defaults are the state a newly placed widget shows until its first update. RemoteViews can't
     reach the optional brand fonts, so numbers set in the system monospace face. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- The refresh button is its own 48dp tap target; its glyph lines up with the content edge. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ph_cloud_arrow_down_fill"
            android:tint="@color/putio_yellow_solid" />

        <TextView
            android:id="@+id/widget_transfers_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/mobile_destination_transfers"
            android:textColor="@color/putio_text"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/widget_transfers_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-14dp"
            android:contentDescription="@string/mobile_widget_refresh"
            android:padding="14dp"
            android:src="@drawable/ic_ph_arrows_clockwise"
            android:tint="@color/putio_text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_transfers_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/mobile_widget_transfers_loading"
        android:textColor="@color/putio_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/widget_transfers_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_transfers_row_0_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/putio_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_transfers_row_0_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/putio_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_transfers_row_0_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/putio_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_transfers_row_0_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:indeterminateTint="@color/putio_yellow_solid"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_downloading"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/widget_transfers_row_0_progress_seeding"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_seeding"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_transfers_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_transfers_row_1_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/putio_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_transfers_row_1_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/putio_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_transfers_row_1_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/putio_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_transfers_row_1_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:indeterminateTint="@color/putio_yellow_solid"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_downloading"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/widget_transfers_row_1_progress_seeding"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_seeding"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_transfers_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_transfers_row_2_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/putio_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_transfers_row_2_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/putio_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_transfers_row_2_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/putio_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_transfers_row_2_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:indeterminateTint="@color/putio_yellow_solid"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_downloading"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/widget_transfers_row_2_progress_seeding"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_seeding"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_transfers_footer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_transfers_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/putio_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_transfers_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/putio_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
