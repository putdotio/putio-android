<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Compose tests install content once. API 37 asset-overlay updates otherwise
             recreate this synthetic host with a blank UI during a running test. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:configChanges="assetsPaths" />
        <!-- Preserve injected video proof content while its real window changes orientation or
             size, and host the video's picture-in-picture as MainActivity does. -->
        <activity
            android:name=".MobileFullscreenProofActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|assetsPaths"
            android:exported="false"
            android:supportsPictureInPicture="true" />
        <!-- The tablet proof's shell host: MainActivity's configuration changes, plus the test host's assets. -->
        <activity
            android:name=".MobileTabletProofActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|assetsPaths"
            android:exported="false" />
    </application>
</manifest>
