<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Compose tests install content once. API 37 asset-overlay updates otherwise
             recreate this synthetic host with a blank UI during a running test. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:configChanges="assetsPaths" />
        <!-- Preserve injected video proof content while its real window changes orientation. -->
        <activity
            android:name=".MobileFullscreenProofActivity"
            android:configChanges="orientation|screenSize|assetsPaths"
            android:exported="false" />
    </application>
</manifest>
