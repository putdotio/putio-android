<!-- put.io as an Android TV global search source: the system search app reads the
     suggestions provider as the viewer types, and a chosen row opens putio://files/<id>.
     The authority is generated per variant, so debug and nightly installs answer apart. -->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="@string/tv_search_field"
    android:searchSettingsDescription="@string/tv_global_search_description"
    android:searchSuggestAuthority="@string/tv_search_authority"
    android:searchSuggestIntentAction="android.intent.action.VIEW"
    android:searchSuggestIntentData="putio://files"
    android:searchSuggestSelection=" ?"
    android:searchSuggestThreshold="1"
    android:includeInGlobalSearch="true" />
