<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV banner: the generated retro wordmark centred on the app background.
     The platform spec fixes the banner at 320x180dp; the wordmark keeps its 376:112 box. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/putio_app_bg" />
            <size
                android:width="320dp"
                android:height="180dp" />
        </shape>
    </item>
    <item
        android:width="235dp"
        android:height="70dp"
        android:drawable="@drawable/putio_wordmark"
        android:gravity="center" />
</layer-list>
