{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>putdotio/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "The API 26 Robolectric runtime must stay on Android 8.0; newer 8.x builds are API 27.",
      "matchPackageNames": [
        "org.robolectric:android-all-instrumented"
      ],
      "matchCurrentValue": "/^8\\./",
      "enabled": false
    }
  ]
}
